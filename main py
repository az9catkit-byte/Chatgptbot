async def save_group_info(chat: types.Chat):
    try:
        groups = {}
        if os.path.exists(GROUPS_FILE):
            async with aiofiles.open(GROUPS_FILE, 'r', encoding='utf-8') as f:
                try:
                    groups = json.loads(await f.read())
                except:
                    groups = {}
        groups[str(chat.id)] = {
            "id": chat.id,
            "title": chat.title or "Без названия",
            "type": chat.type,
            "added_at": time.time()
        }
        async with aiofiles.open(GROUPS_FILE, 'w', encoding='utf-8') as f:
            await f.write(json.dumps(groups, ensure_ascii=False, indent=2))
    except Exception as e:
        print(f"Ошибка сохранения группы: {e}")


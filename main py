# === СМЕНА КЛЮЧА GROQ ===
def update_config_value(key: str, new_value: str) -> bool:
    try:
        import config
        with open(config.__file__, 'r', encoding='utf-8') as f:
            lines = f.readlines()
        with open(config.__file__, 'w', encoding='utf-8') as f:
            for line in lines:
                if line.strip().startswith(key):
                    f.write(f'{key} = "{new_value}"\n')
                else:
                    f.write(line)
        import importlib
        importlib.reload(config)
        return True
    except Exception as e:
        print(f"Ошибка обновления конфига: {e}")
        return False

async def update_groq_client(new_key: str):
    global groq_client, GROQ_API_KEY
    if update_config_value("GROQ_API_KEY", new_key):
        GROQ_API_KEY = new_key
        groq_client = AsyncGroq(api_key=new_key)
        return True
    return False


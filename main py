BACKUP_FILENAME = "bot_data_backup.zip"

async def create_backup_zip() -> str | None:
    """Создаёт ZIP-архив со всеми данными бота."""
    try:
        backup_path = os.path.join(DOWNLOADS_DIR, BACKUP_FILENAME)
        with zipfile.ZipFile(backup_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
            # История диалогов
            for root, _, files in os.walk(DATA_DIR):
                for file in files:
                    if file.endswith('.json'):
                        full_path = os.path.join(root, file)
                        arcname = os.path.relpath(full_path, BASE_DIR)
                        zipf.write(full_path, arcname)
            # Активность
            for root, _, files in os.walk(ACTIVITY_DIR):
                for file in files:
                    if file.endswith('.json'):
                        full_path = os.path.join(root, file)
                        arcname = os.path.relpath(full_path, BASE_DIR)
                        zipf.write(full_path, arcname)
            # groups.json
            if os.path.exists(GROUPS_FILE):
                zipf.write(GROUPS_FILE, os.path.basename(GROUPS_FILE))
            # config.py (чтобы сохранить токены)
            config_path = os.path.join(BASE_DIR, "config.py")
            if os.path.exists(config_path):
                zipf.write(config_path, "config.py")
        return backup_path
    except Exception as e:
        print(f"Ошибка создания бэкапа: {e}")
        return None

async def upload_to_telegram_cloud(file_path: str) -> bool:
    """Отправляет архив в приватный канал."""
    try:
        await bot.send_document(
            int(CLOUD_CHANNEL_ID),
            FSInputFile(file_path, filename=BACKUP_FILENAME)
        )
        return True
    except Exception as e:
        print(f"Ошибка отправки в облако: {e}")
        return False

async def restore_from_telegram_cloud() -> bool:
    """Скачивает последний бэкап из канала и восстанавливает данные."""
    try:
        # Получаем последние сообщения из канала
        updates = await bot.get_updates(offset=-10, limit=10, timeout=5)
        target_message = None
        for update in reversed(updates):
            msg = update.message
            if msg and msg.document and msg.chat.id == int(CLOUD_CHANNEL_ID):
                target_message = msg
                break

        if not target_message:
            print("Бэкап в канале не найден.")
            return False

        file_id = target_message.document.file_id
        file = await bot.get_file(file_id)
        downloaded_path = os.path.join(DOWNLOADS_DIR, "restored_backup.zip")
        await bot.download_file(file.file_path, downloaded_path)

        # Распаковываем
        with zipfile.ZipFile(downloaded_path, 'r') as zipf:
            zipf.extractall(BASE_DIR)

        os.remove(downloaded_path)
        print("Данные успешно восстановлены из облака.")
        return True
    except Exception as e:
        print(f"Ошибка восстановления: {e}")
        return False

async def restore_on_startup():
    """Автоматическое восстановление данных при старте."""
    if not any(os.listdir(DATA_DIR)) and not os.path.exists(GROUPS_FILE):
        print("Локальные данные отсутствуют. Пробуем восстановить из облака...")
        if await restore_from_telegram_cloud():
            print("Восстановление прошло успешно.")
        else:
            print("Не удалось восстановить данные из облака. Начинаем с чистого листа.")


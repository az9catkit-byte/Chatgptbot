def get_activity_file_path(user_id: int) -> str:
    return os.path.join(ACTIVITY_DIR, f"{user_id}.json")

async def update_user_activity(user_id: int, user: types.User = None):
    file_path = get_activity_file_path(user_id)
    data = {"last_active": time.time()}
    if user:
        data["first_name"] = user.first_name
        data["last_name"] = user.last_name
        data["username"] = user.username
    else:
        if os.path.exists(file_path):
            async with aiofiles.open(file_path, 'r', encoding='utf-8') as f:
                try:
                    old_data = json.loads(await f.read())
                    data.update({k: v for k, v in old_data.items() if k != "last_active"})
                except:
                    pass
    async with aiofiles.open(file_path, 'w', encoding='utf-8') as f:
        await f.write(json.dumps(data, ensure_ascii=False))

async def get_all_users_activity() -> dict:
    result = {}
    for filename in os.listdir(ACTIVITY_DIR):
        if filename.endswith('.json'):
            user_id = int(filename.replace('.json', ''))
            try:
                async with aiofiles.open(os.path.join(ACTIVITY_DIR, filename), 'r') as f:
                    data = json.loads(await f.read())
                    result[user_id] = data
            except:
                pass
    return result


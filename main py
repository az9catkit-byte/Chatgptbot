BACKUP_FILENAME = "bot_data_backup.zip"

# Файл для хранения message_id последнего бэкапа в канале
BACKUP_INDEX_FILE = os.path.join(BASE_DIR, "last_backup_msg_id.txt")


def _save_backup_msg_id(msg_id: int):
    """Сохраняет message_id последнего бэкапа локально."""

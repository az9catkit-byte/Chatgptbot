# === РЕНДЕРИНГ СКИНА (УЛУЧШЕННЫЙ) ===
def render_skin_front(skin_path: str, scale: int = 8) -> Image.Image:
    skin = Image.open(skin_path).convert("RGBA")
    width, height = skin.size
    # Проверка минимальной ширины
    if width < 64:
        raise ValueError(f"Скин слишком узкий: {width} пикселей. Минимум 64.")
    # Если ширина больше 64, обрежем или изменим размер
    if width > 64:
        skin = skin.resize((64, int(height * 64 / width)), Image.NEAREST)
        width, height = skin.size
    # Теперь проверяем высоту
    if height not in (32, 64):
        # Для некоторых старых скинов 64x48 — обрежем до 64x32
        if height == 48:
            skin = skin.crop((0, 0, 64, 32))
            height = 32
        elif height > 64:
            skin = skin.crop((0, 0, 64, 64))
            height = 64
        else:
            raise ValueError(f"Неизвестный формат скина: {width}x{height}. Допустимы: 64x32, 64x64.")
    
    body_width = 16 * scale
    body_height = 32 * scale
    result = Image.new("RGBA", (body_width, body_height), (0, 0, 0, 0))
    # Голова
    head = skin.crop((8, 8, 16, 16)).resize((8 * scale, 8 * scale), Image.NEAREST)
    # Тело
    body = skin.crop((20, 20, 28, 32)).resize((8 * scale, 12 * scale), Image.NEAREST)
    # Правая нога
    leg_right = skin.crop((4, 20, 8, 32)).resize((4 * scale, 12 * scale), Image.NEAREST)
    # Левая нога (только если высота 64)
    if height == 64:
        leg_left = skin.crop((20, 52, 24, 64)).resize((4 * scale, 12 * scale), Image.NEAREST)
    else:
        leg_left = Image.new("RGBA", (4 * scale, 12 * scale), (0, 0, 0, 0))
    # Правая рука
    arm_right = skin.crop((44, 20, 48, 32)).resize((4 * scale, 12 * scale), Image.NEAREST)
    # Левая рука (только если высота 64)
    if height == 64:
        arm_left = skin.crop((36, 52, 40, 64)).resize((4 * scale, 12 * scale), Image.NEAREST)
    else:
        arm_left = Image.new("RGBA", (4 * scale, 12 * scale), (0, 0, 0, 0))
    
    offset_x = 4 * scale
    result.paste(head, (offset_x, 0), head)
    result.paste(body, (offset_x, 8 * scale), body)
    result.paste(arm_left, (offset_x - 4 * scale, 8 * scale), arm_left)
    result.paste(arm_right, (offset_x + 8 * scale, 8 * scale), arm_right)
    result.paste(leg_left, (offset_x, 20 * scale), leg_left)
    result.paste(leg_right, (offset_x + 4 * scale, 20 * scale), leg_right)
    return result

async def create_skin_card(skin_path: str, bg_path: str, user_id: int, nickname: str) -> str | None:
    try:
        avatar = render_skin_front(skin_path, scale=8)
        bg = Image.open(bg_path).convert("RGBA")
        target_size = (800, 600)
        bg = bg.resize(target_size, Image.LANCZOS)
        avatar_w, avatar_h = avatar.size
        avatar_x = (target_size[0] - avatar_w) // 2
        avatar_y = int(target_size[1] * 0.3)
        bg.paste(avatar, (avatar_x, avatar_y), avatar)
        draw = ImageDraw.Draw(bg)
        font_size = 40
        try:
            font = ImageFont.truetype("arial.ttf", font_size)
        except:
            font = ImageFont.load_default()
        text = nickname.upper()
        text_bbox = draw.textbbox((0, 0), text, font=font)
        text_w = text_bbox[2] - text_bbox[0]
        text_h = text_bbox[3] - text_bbox[1]
        text_x = (target_size[0] - text_w) // 2
        text_y = avatar_y + avatar_h + 20
        draw.text((text_x-2, text_y-2), text, font=font, fill="black")
        draw.text((text_x+2, text_y-2), text, font=font, fill="black")
        draw.text((text_x-2, text_y+2), text, font=font, fill="black")
        draw.text((text_x+2, text_y+2), text, font=font, fill="black")
        draw.text((text_x, text_y), text, font=font, fill="white")
        result_path = os.path.join(DOWNLOADS_DIR, f"{user_id}_card.png")
        bg.save(result_path)
        return result_path
    except Exception as e:
        raise ValueError(f"Ошибка при создании карточки: {str(e)}")


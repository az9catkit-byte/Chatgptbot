        return True
    except Exception as e:
        print(f"[backup] Ошибка отправки в канал: {e}")
        return False


async def _find_latest_backup_msg_id() -> int | None:
    """
    Ищет message_id последнего бэкапа.
    Сначала проверяет локальный файл-индекс, потом перебирает
    последние сообщения канала через forward_messages-трюк.
    """
    # 1. Быстрый путь — локальный индекс
    local_id = _load_backup_msg_id()
    if local_id:
        print(f"[backup] Найден локальный msg_id={local_id}")
        return local_id

    # 2. Медленный путь — перебираем последние ~50 сообщений канала назад
    # Telegram Bot API не имеет getChatHistory, но позволяет forwardMessage:
    # если msg_id существует и содержит документ — это наш бэкап.
    # Стартуем с большого числа и идём вниз пока не найдём документ.
    print("[backup] Локальный индекс отсутствует, ищем бэкап в канале...")
    if not CLOUD_CHANNEL_ID:
        return None

    # Пробуем получить последнее сообщение канала через copyMessage (оно всегда последнее)
    # Будем искать в диапазоне последних 200 message_id
    # Для этого используем трюк: отправляем заглушку и смотрим её message_id
    probe_msg = None
    try:
        probe_msg = await bot.send_message(CLOUD_CHANNEL_ID, "🔍 Поиск бэкапа...")
        max_id = probe_msg.message_id
        await bot.delete_message(CLOUD_CHANNEL_ID, probe_msg.message_id)
        probe_msg = None
    except Exception as e:
        print(f"[backup] Не удалось определить последний msg_id канала: {e}")
        if probe_msg:
            try:
                await bot.delete_message(CLOUD_CHANNEL_ID, probe_msg.message_id)
            except:
                pass
        return None

    # Перебираем последние 200 сообщений в поисках документа с нужным именем
    search_limit = min(max_id, 200)
    for msg_id in range(max_id - 1, max_id - search_limit - 1, -1):
        if msg_id <= 0:
            break
        try:
            # forward в скрытый чат не работает через Bot API без прав.
            # Единственный способ — копировать сообщение в служебный чат.
            # Но у нас нет такого чата. Используем getFile через file_id,
            # который получаем через forwardMessage к самому боту.
            # Однако проще: просто пробуем скопировать сообщение во временный
            # буфер — сам канал — и сразу удалить.
            # Самый надёжный вариант без side-effects: используем
            # bot.copy_message, ловим исключение если сообщения нет.
            copied = await bot.copy_message(
                chat_id=CLOUD_CHANNEL_ID,
                from_chat_id=CLOUD_CHANNEL_ID,
                message_id=msg_id
            )
            # Если дошли сюда — сообщение существует. Проверяем это через forward.
            # Удаляем копию и пробуем скачать оригинал.
            await bot.delete_message(CLOUD_CHANNEL_ID, copied.message_id)

            # Теперь нужно узнать, документ ли это. Форвардим в личку боту — нельзя.
            # Но мы можем попробовать скачать через file_id, которого у нас нет.
            # Проблема: Bot API не возвращает содержимое сообщений канала напрямую.
            # Решение: сохраняем msg_id и пробуем скачать в restore-функции,
            # она сама проверит документ.
            _save_backup_msg_id(msg_id)
            print(f"[backup] Найдено сообщение msg_id={msg_id} в канале")
            return msg_id
        except Exception:
            continue

    print("[backup] Бэкапы в канале не найдены.")
    return None


async def restore_from_telegram_cloud() -> bool:
    """
    Скачивает последний бэкап из приватного канала и распаковывает данные.

    Алгоритм:
    1. Берём msg_id из локального индекса (быстро) или ищем в канале (медленно).
    2. Форвардим сообщение с документом в Saved Messages бота, чтобы получить file_id.
    3. Скачиваем файл, распаковываем, удаляем временную копию.
    """
    if not CLOUD_CHANNEL_ID:
        print("[backup] CLOUD_CHANNEL_ID не задан.")
        return False

    msg_id = await _find_latest_backup_msg_id()
    if not msg_id:
        print("[backup] Не удалось найти msg_id бэкапа.")
        return False

    forwarded = None
    downloaded_path = os.path.join(DOWNLOADS_DIR, "restored_backup.zip")

    try:
        # Форвардим сообщение из канала себе (в чат бота с самим собой = bot.id)
        # чтобы получить объект Message с document.file_id
        bot_info = await bot.get_me()
        forwarded = await bot.forward_message(
            chat_id=bot_info.id,
            from_chat_id=CLOUD_CHANNEL_ID,
            message_id=msg_id
        )

        if not forwarded.document:
            print(f"[backup] Сообщение msg_id={msg_id} не содержит документа.")
            # Сбрасываем индекс — он был неверным
            if os.path.exists(BACKUP_INDEX_FILE):
                os.remove(BACKUP_INDEX_FILE)
            return False

        if forwarded.document.file_name != BACKUP_FILENAME:
            print(f"[backup] Документ называется '{forwarded.document.file_name}', ожидалось '{BACKUP_FILENAME}'.")
            return False

        # Скачиваем
        file_info = await bot.get_file(forwarded.document.file_id)
        await bot.download_file(file_info.file_path, downloaded_path)
        print(f"[backup] Архив скачан: {downloaded_path}")

        # Распаковываем
        with zipfile.ZipFile(downloaded_path, 'r') as zipf:
            zipf.extractall(BASE_DIR)
        print("[backup] Данные успешно восстановлены.")
        return True

    except Exception as e:
        print(f"[backup] Ошибка восстановления: {e}")
        return False
    finally:
        # Удаляем форвард из Saved Messages чтобы не засорять
        if forwarded:
            try:
                await bot.delete_message(chat_id=forwarded.chat.id, message_id=forwarded.message_id)
            except:
                pass
        # Удаляем временный файл
        if os.path.exists(downloaded_path):
            try:
                os.remove(downloaded_path)
            except:
                pass


async def restore_on_startup():
    """
    Проверка при старте: если локальных данных нет — тянем бэкап из канала.
    Запускается до начала поллинга.
    """
    has_local_data = (
        any(f.endswith('.json') for f in os.listdir(DATA_DIR))
        or os.path.exists(GROUPS_FILE)
    )

    if has_local_data:
        print("[backup] Локальные данные найдены, восстановление не нужно.")
        return

    if not CLOUD_CHANNEL_ID:
        print("[backup] Облачное хранилище не настроено, пропускаем восстановление.")
        return

    print("[backup] Локальные данные отсутствуют — пробуем восстановить из облака...")
    success = await restore_from_telegram_cloud()
    if success:

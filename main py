URL_REGEX = re.compile(r'(https?://[^\s]+)')

@dp.message(lambda message: message.text and URL_REGEX.search(message.text))
async def handle_url_message(message: types.Message):
    await update_user_activity(message.from_user.id, message.from_user)

    if message.chat.type != "private" and not await is_bot_mentioned(message):
        return

    if message.from_user.id in admin_sessions and message.from_user.id in control_sessions:
        return

    for admin_id, target_chat_id in group_control_sessions.items():
        if message.chat.id == target_chat_id:
            user = message.from_user
            tag = f"@{user.username}" if user.username else str(user.id)
            sender_info = f"{user.full_name or 'Без имени'}({tag})"
            await bot.send_message(admin_id, f"{sender_info}\n🔗 Прислана ссылка.")
            await bot.forward_message(admin_id, message.chat.id, message.message_id)
            return

    urls = URL_REGEX.findall(message.text)
    for url in urls:
        if any(domain in url for domain in ['youtu.be', 'youtube.com', 'tiktok.com']):
            await message.reply(f"🔗 Обнаружена ссылка. Скачиваю {url}...")
            file_path = await download_video(url, message.from_user.id)

            if file_path and os.path.exists(file_path):
                try:
                    video_file = FSInputFile(file_path)
                    await bot.send_video(message.chat.id, video_file)
                except Exception as e:
                    await message.reply(f"❌ Ошибка отправки видео: {e}")
                finally:
                    if os.path.exists(file_path):
                        os.remove(file_path)
            elif file_path == "UNAVAILABLE":
                await message.reply("❌ Видео недоступно. Возможно, оно приватное или удалено.")
            elif file_path == "GEO_RESTRICTED":
                await message.reply("❌ Это видео недоступно в вашем регионе.")
            elif file_path == "SIZE_LIMIT":
                await message.reply("❌ Видео слишком большое (более 50 МБ).")
            else:
                await message.reply("❌ Не удалось скачать видео.")
            break


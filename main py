def _load_backup_msg_id() -> int | None:
    """Читает message_id последнего бэкапа из локального файла."""
    try:
        if os.path.exists(BACKUP_INDEX_FILE):
            with open(BACKUP_INDEX_FILE, 'r') as f:
                val = f.read().strip()
                return int(val) if val else None
    except Exception as e:
        print(f"[backup] Не удалось прочитать msg_id: {e}")
    return None


async def create_backup_zip() -> str | None:
    """Создаёт ZIP-архив со всеми данными бота."""
    try:
        backup_path = os.path.join(DOWNLOADS_DIR, BACKUP_FILENAME)
        with zipfile.ZipFile(backup_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
            # История диалогов
            for root, _, files in os.walk(DATA_DIR):
                for file in files:
                    if file.endswith('.json'):
                        full_path = os.path.join(root, file)
                        arcname = os.path.relpath(full_path, BASE_DIR)
                        zipf.write(full_path, arcname)
            # Активность пользователей
            for root, _, files in os.walk(ACTIVITY_DIR):
                for file in files:
                    if file.endswith('.json'):
                        full_path = os.path.join(root, file)
                        arcname = os.path.relpath(full_path, BASE_DIR)
                        zipf.write(full_path, arcname)
            # Список групп
            if os.path.exists(GROUPS_FILE):
                zipf.write(GROUPS_FILE, os.path.basename(GROUPS_FILE))
        print(f"[backup] Архив создан: {backup_path}")
        return backup_path
    except Exception as e:
        print(f"[backup] Ошибка создания архива: {e}")
        return None


async def upload_to_telegram_cloud(file_path: str) -> bool:
    """
    Отправляет ZIP в приватный канал и сохраняет message_id отправленного сообщения.
    message_id нужен для надёжного скачивания при восстановлении.
    """
    if not CLOUD_CHANNEL_ID:

# === ФАЙЛЫ ===
async def download_file(file_id: str, destination: str):
    file = await bot.get_file(file_id)
    await bot.download_file(file.file_path, destination)

def extract_text_from_txt(file_path: str) -> str:
    with open(file_path, 'r', encoding='utf-8') as f:
        return f.read()

def extract_text_from_pdf(file_path: str) -> str:
    text = ""
    with open(file_path, 'rb') as f:
        reader = PyPDF2.PdfReader(f)
        for page in reader.pages:
            text += page.extract_text() or ""
    return text

def extract_text_from_docx(file_path: str) -> str:
    doc = Document(file_path)
    return "\n".join([p.text for p in doc.paragraphs])

async def process_document(message: types.Message) -> tuple[str, str]:
    document = message.document
    file_name = document.file_name.lower()
    file_id = document.file_id
    file_path = os.path.join(DOWNLOADS_DIR, f"{message.from_user.id}_{file_id}_{file_name}")

    await download_file(file_id, file_path)

    extracted_text = ""
    if file_name.endswith('.txt'):
        extracted_text = extract_text_from_txt(file_path)
    elif file_name.endswith('.pdf'):
        extracted_text = extract_text_from_pdf(file_path)
    elif file_name.endswith('.docx'):
        extracted_text = extract_text_from_docx(file_path)
    else:
        os.remove(file_path)
        raise ValueError("Неподдерживаемый формат. Можно: TXT, PDF, DOCX.")

    os.remove(file_path)
    return file_name, extracted_text.strip()

# === ВИДЕО ===
async def download_video(url: str, user_id: int) -> str | None:
    ydl_opts = {
        'format': "bestvideo[height<=720][ext=mp4]+bestaudio[ext=m4a]/best[height<=720]/best",
        'merge_output_format': 'mp4',
        'quiet': True,
        'no_warnings': True,
        'outtmpl': os.path.join(DOWNLOADS_DIR, f'{user_id}_%(title)s.%(ext)s'),
        'restrictfilenames': True,
    }

    now = time.time()
    for f in glob.glob(os.path.join(DOWNLOADS_DIR, f"{user_id}_*")):
        try:
            if os.path.getmtime(f) < now - 7200:
                os.remove(f)
        except:
            pass
    for f in glob.glob(os.path.join(DOWNLOADS_DIR, "*.part")):
        try:
            if os.path.getmtime(f) < now - 3600:
                os.remove(f)
        except:
            pass

    try:
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=False)
            duration = info.get('duration', 0)
            if duration and duration > 3600:
                print(f"Видео длиннее 1 часа ({duration} сек), возможно, оно будет слишком большим.")
            ydl.download([url])
            filename = ydl.prepare_filename(info)

            base, _ = os.path.splitext(filename)
            for ext in ['.mp4', '.webm', '.mkv']:
                potential_path = base + ext
                if os.path.exists(potential_path):
                    if os.path.getsize(potential_path) > 50 * 1024 * 1024:
                        os.remove(potential_path)
                        return "SIZE_LIMIT"
                    return potential_path

            for f in glob.glob(base + ".*"):
                if os.path.getsize(f) > 50 * 1024 * 1024:
                    os.remove(f)
                    return "SIZE_LIMIT"
                return f
            return None

    except yt_dlp.utils.DownloadError as e:
        error_msg = str(e).lower()
        if "video unavailable" in error_msg or "private" in error_msg or "removed" in error_msg:
            return "UNAVAILABLE"
        elif "geo-restricted" in error_msg or "not available in your country" in error_msg:
            return "GEO_RESTRICTED"
        else:
            print(f"Ошибка скачивания: {e}")
            return None
    except Exception as e:
        print(f"Неизвестная ошибка при скачивании: {e}")
        return None

# === ГЕНЕРАЦИЯ ИЗОБРАЖЕНИЙ ===
async def generate_image(prompt: str, user_id: int) -> str | None:
    api_result = await generate_via_api(prompt)
    if api_result:
        return api_result
    fallback_result = await generate_via_fallback(prompt, user_id)
    if fallback_result:
        return fallback_result
    return None

async def generate_via_api(prompt: str) -> str | None:
    url = "https://api.pollinations.ai/v1/images/generations"
    headers = {
        "Authorization": f"Bearer {POLLINATIONS_API_KEY}",
        "Content-Type": "application/json"
    }
    payload = {
        "prompt": prompt,
        "n": 1,
        "size": "1024x1024"
    }
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(url, json=payload, headers=headers,
                                    timeout=aiohttp.ClientTimeout(total=45)) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if "data" in data and len(data["data"]) > 0:
                        return data["data"][0]["url"]
    except:
        pass
    return None

async def generate_via_fallback(prompt: str, user_id: int) -> str | None:
    encoded = urllib.parse.quote(prompt)
    image_url = f"https://image.pollinations.ai/prompt/{encoded}?model=flux&width=1024&height=1024&nologo=true"
    file_path = os.path.join(DOWNLOADS_DIR, f"{user_id}_fallback.png")
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(image_url, timeout=aiohttp.ClientTimeout(total=60)) as resp:
                if resp.status == 200:
                    content_type = resp.headers.get('Content-Type', '')
                    if 'image' not in content_type:
                        return None
                    content = await resp.read()
                    async with aiofiles.open(file_path, 'wb') as f:
                        await f.write(content)
                    return file_path
    except:
        pass
    return None

# === УПОМИНАНИЕ БОТА ===
async def is_bot_mentioned(message: types.Message) -> bool:
    try:
        bot_username = (await bot.me()).username
    except:
        return False
    if message.reply_to_message and message.reply_to_message.from_user.id == bot.id:
        return True
    if message.entities:
        for entity in message.entities:
            if entity.type == "mention":
                mention = message.text[entity.offset:entity.offset+entity.length]
                if mention == f"@{bot_username}":
                    return True
    if message.text and f"@{bot_username}" in message.text:
        return True
    return False

def clean_text_from_mention(text: str, bot_username: str) -> str:
    pattern = rf"@{re.escape(bot_username)}\s*"
    return re.sub(pattern, "", text).strip()


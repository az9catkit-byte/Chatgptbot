        await message.reply("⛔ У вас нет прав для этой команды.")
        return

    activities = await get_all_users_activity()
    if not activities:
        await message.reply("📭 Нет данных об активности пользователей.")
        return

    now = time.time()
    lines = ["👥 **Статус пользователей:**\n"]
    for user_id, data in sorted(activities.items(), key=lambda x: x[1].get("last_active", 0), reverse=True):
        last_active = data.get("last_active", 0)
        delta = now - last_active
        status = "🟢 онлайн" if delta < ONLINE_THRESHOLD else "🔴 офлайн"
        time_str = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(last_active))

        if "username" in data and data["username"]:
            display_name = f"@{data['username']} ({user_id})"
        elif "first_name" in data:
            name_parts = [data["first_name"]]
            if data.get("last_name"):
                name_parts.append(data["last_name"])
            display_name = f"{' '.join(name_parts)} ({user_id})"
        else:
            display_name = f"ID:{user_id}"

        lines.append(f"• {display_name}: {status} (посл. {time_str})")

    text = "\n".join(lines[:31])
    if len(lines) > 31:
        text += f"\n... и ещё {len(lines)-31}"
    await message.reply(text)

